//====================================================================== JOB APPLICATION ====================================================================
###Get all
GET {{backend_HostAddress}}/api/jobApplications/getAll
Content-Type: application/json
Cookie: access_token={{access_Token}}

###Get by id
GET {{backend_HostAddress}}/api/jobApplications/getById/14
Content-Type: application/json
Cookie: access_token={{access_Token}}

###Create new JA
POST {{backend_HostAddress}}/api/jobApplications/create
Content-Type: application/json
Cookie: access_token={{access_Token}}

{
  "companyId": 10,
  "jobTitle": "Token test",
  "jobPostingUrl": "https://careers.google.com/jobs/123",
  "location": "Remote",
  "dateApplied": "2026-08-27",
  "notes": "Applied through referral"
}

###Update by id
PUT {{backend_HostAddress}}/api/JobApplications/update/14
Content-Type: application/json
Cookie: access_token={{access_Token}}

{
  "JobTitle": "Backend Dev",
  "notes": "Note field got updated"
}

###Update JA status
POST {{backend_HostAddress}}/api/JobApplications/updateStatus/14
Content-Type: application/json
Cookie: access_token={{access_Token}}

{
  "Status": "Interviewing",
  "Note": "Test note"
}

###Get all status history
GET {{backend_HostAddress}}/api/JobApplications/getAllStatusHistoryById/14
Content-Type: application/json
Cookie: access_token={{access_Token}}

###Job posting details upsert
PUT {{backend_HostAddress}}/api/JobApplications/jobPostingDetailsUpsert/14
Content-Type: application/json
Cookie: access_token={{access_Token}}

{
  "RawText": "Lorem ispum",
  "DetailsJson": "{\"aboutCompany\": \"A fast-growing startup\", \"whyJoinUs\": \"Great benefits and remote-first culture\"}"
}

###Get job posting detail by job application id
GET {{backend_HostAddress}}/api/JobApplications/jobPostingDetailsGetById/14
Content-Type: application/json
Cookie: access_token={{access_Token}}

